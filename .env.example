# ---- where things are -------------------------------------------------------
# Your ripped ISOs. Mounted read-only; Disc Two never writes here.
ISO_DIR=/path/to/isos
# Its own state: review records, cover photos, the disc catalogue.
STATE_DIR=/path/to/config
# Your film library, mounted the SAME WAY your *arr mounts it, so the paths it
# returns over the API are valid in here without rewriting.
MEDIA_DIR=/path/to/data

# ---- Radarr (optional, but it is how folders get named correctly) -----------
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
# Which profile new films are added on. Left blank, the profile your library
# already uses most is chosen, which is almost always the right answer.
RADARR_QUALITY_PROFILE=

# ---- Plex (optional; only used to ask for a rescan after importing) ---------
PLEX_URL=
PLEX_TOKEN=

# ---- local vision model (optional, and the single biggest accuracy win) -----
# Any Ollama with a vision model. Without it, cover and menu reading fall back
# to tesseract, which is noticeably worse.
OLLAMA_URL=
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Warm the model while a disc is being reviewed rather than on first use.
VISION_PRELOAD=1

# ---- encoding ---------------------------------------------------------------
# nvenc_h265 when a GPU is reachable, x265 otherwise; set to force one.
EXTRAS_ENCODER=
EXTRAS_QUALITY=22
# Deinterlacing dominates the runtime. See docs/ENCODING.md before changing.
EXTRAS_FILTERS=--detelecine --deinterlace

# ---- filing -----------------------------------------------------------------
EXTRAS_SUBDIR=Featurettes
EXTRAS_UID=1000
EXTRAS_GID=1000
